-- Dùng Box Highlight màu xanh dương bao quanh nhân vật thay vì viền phẳng
RunService.RenderStepped:Connect(function()
    if not getgenv().TphatFixLagLoaded then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local highlight = p.Character:FindFirstChild("TphatESPBox")
            if espEnabled then
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "TphatESPBox"
                    highlight.Adornee = p.Character
                    highlight.FillColor = Color3.fromRGB(0, 150, 255)
                    highlight.FillTransparency = 0.5  -- Tạo khung màu bên trong
                    highlight.OutlineColor = Color3.fromRGB(0, 255, 255)
                    highlight.OutlineTransparency = 0
                    highlight.Parent = p.Character
                end
            else
                if highlight then
                    highlight:Destroy()
                end
            end
        end
    end
end)

