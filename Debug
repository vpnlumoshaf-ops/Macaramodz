ExecuteFixBtn.MouseButton1Click:Connect(function()
    -- Fix nhẹ: Xóa trang phục
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then
            for _, v in ipairs(p.Character:GetChildren()) do
                if v:IsA("Accessory") or v:IsA("Clothing") or v:IsA("ShirtGraphic") then
                    v:Destroy()
                end
            end
        end
    end

    if currentFixLevel == "TrungBinh" or currentFixLevel == "Manh" then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Texture") or obj:IsA("Decal") then
                obj:Destroy()
            end
        end
    end

    if currentFixLevel == "Manh" then
        -- Xóa triệt để Animation đang chạy (giúp rồng dừng vỗ cánh, nhân vật đứng cứng)
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character then
                local humanoid = p.Character:FindFirstChildOfClass("Humanoid")
                if humanoid then
                    local animator = humanoid:FindFirstChildOfClass("Animator")
                    if animator then
                        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                            track:Stop()
                            track:Destroy()
                        end
                    end
                end
                -- Xóa cả các pet/model rồng bay lượn gắn trên người chơi nếu có
                for _, child in ipairs(p.Character:GetChildren()) do
                    if child:IsA("Model") or child:IsA("BasePart") and child.Name ~= "HumanoidRootPart" then
                        if child.Name:lower():find("dragon") or child.Name:lower():find("pet") or child.Name:lower():find("egg") then
                            child:Destroy()
                        end
                    end
                end
            end
        end

        -- Xóa hiệu ứng VFX / Hạt
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("ParticleEmitter") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") or obj:IsA("Trail") or obj:IsA("Beam") then
                obj:Destroy()
            end
        end
    end
end)

