-- Hàm tạo Toast Notification nổi trong game
local function showToast(message)
    local existing = ScreenGui:FindFirstChild("TphatToast")
    if existing then existing:Destroy() end

    local toast = Instance.new("TextLabel")
    toast.Name = "TphatToast"
    toast.Size = UDim2.new(0, 320, 0, 35)
    toast.Position = UDim2.new(0.5, -160, 0.85, 0)
    toast.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    toast.TextColor3 = Color3.fromRGB(255, 255, 0)
    toast.TextSize = 13
    toast.Font = Enum.Font.SourceSansBold
    toast.Text = message
    toast.Parent = ScreenGui
    Instance.new("UICorner", toast).CornerRadius = UDim.new(0, 0)

    task.delay(2.5, function()
        if toast then toast:Destroy() end
    end)
end

