local function executeScan()
    local logs = {}
    table.insert(logs, "=== [ THÔNG TIN NHÂN VẬT ] ===")
    
    pcall(function()
        local data = LocalPlayer:FindFirstChild("Data")
        local lvl = data and data:FindFirstChild("Level") and data.Level.Value or "Không rõ"
        table.insert(logs, "Level hiện tại: " .. tostring(lvl))
    end)

    table.insert(logs, "\n=== [ BẢNG QUEST TRÊN UI ] ===")
    pcall(function()
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        local main = playerGui and playerGui:FindFirstChild("Main")
        local questGui = main and main:FindFirstChild("Quest")
        
        if questGui then
            table.insert(logs, "Trạng thái: Đang hiển thị (Visible = true)")
            local container = questGui:FindFirstChild("Container")
            if container then
                for _, v in ipairs(container:GetDescendants()) do
                    if v:IsA("TextLabel") and v.Text ~= "" then
                        table.insert(logs, "• [" .. v.Name .. "]: " .. v.Text)
                    end
                end
            end
        else
            table.insert(logs, "Trạng thái: Chưa nhận nhiệm vụ hoặc UI ẩn!")
        end
    end)

    table.insert(logs, "\n=== [ TÊN QUÁI TRONG WORKSPACE ] ===")
    pcall(function()
        local enemiesFolder = Workspace:FindFirstChild("Enemies") or Workspace:FindFirstChild("MobFolders")
        if enemiesFolder then
            local count = 0
            local checked = {}
            for _, mob in ipairs(enemiesFolder:GetChildren()) do
                if not checked[mob.Name] and count < 12 then
                    checked[mob.Name] = true
                    count = count + 1
                    table.insert(logs, "• Mob: " .. mob.Name)
                end
            end
        else
            table.insert(logs, "Không tìm thấy thư mục chứa quái!")
        end
    end)

    LogText.Text = table.concat(logs, "\n")
end

RescanBtn.MouseButton1Click:Connect(executeScan)

-- Tự động quét luôn ngay khi bật script
executeScan()
