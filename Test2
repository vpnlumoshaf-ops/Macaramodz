-- Hàm thông báo Toast chuyên nghiệp
local function showToast(msg)
    local t = Instance.new("TextLabel")
    t.Size = UDim2.new(0, 300, 0, 35)
    t.Position = UDim2.new(0.5, -150, 0.85, 0)
    t.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    t.TextColor3 = Color3.fromRGB(255, 255, 0)
    t.TextSize, t.Font = 12, Enum.Font.SourceSansBold
    t.Text = "[Admin Tienphat]: " .. msg
    t.Parent = ScreenGui
    Instance.new("UICorner", t).CornerRadius = UDim.new(0, 0)
    local stroke = Instance.new("UIStroke", t)
    stroke.Color = Color3.fromRGB(255, 255, 255)
    stroke.Thickness = 1
    task.delay(2.5, function() if t then t:Destroy() end end)
end

