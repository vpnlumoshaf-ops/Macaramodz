local FOVSliderFill = Instance.new("Frame")
FOVSliderFill.Size = UDim2.new((120 - 10) / (360 - 10), 0, 1, 0)
FOVSliderFill.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
FOVSliderFill.Parent = FOVSliderBg
Instance.new("UICorner", FOVSliderFill).CornerRadius = UDim.new(0, 4)

local sliderDragging = false
FOVSliderBg.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        sliderDragging = true
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        sliderDragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if sliderDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local pos = input.Position.X
        local absPos = FOVSliderBg.AbsolutePosition.X
        local absSize = FOVSliderBg.AbsoluteSize.X
        local percent = math.clamp((pos - absPos) / absSize, 0, 1)
        
