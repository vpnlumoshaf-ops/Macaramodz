-- Hàm tạo các Tab Content
local function createTabContent()
    local sf = Instance.new("ScrollingFrame")
    sf.Size = UDim2.new(1, 0, 1, 0)
    sf.BackgroundTransparency = 1
    sf.Visible = false
    sf.CanvasSize = UDim2.new(0, 0, 0, 450)
    sf.ScrollBarThickness = 3
    sf.Parent = ContentContainer
    return sf
end

local TabMain = createTabContent()
local TabEsp = createTabContent()
local TabFruit = createTabContent()
local TabAimbot = createTabContent()
TabMain.Visible = true -- Mặc định mở Tab Main

local function createTabBtn(name, yPos)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -6, 0, 32)
    btn.Position = UDim2.new(0, 3, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    btn.Text = name
    btn.TextColor3 = Color3.fromRGB(150, 150, 150)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 12
    btn.Parent = TabContainer
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 0)
    return btn
end

local BtnMain = createTabBtn("Main", 8)
local BtnEsp = createTabBtn("Esp", 45)
local BtnFruit = createTabBtn("Fruit", 82)
local BtnAimbot = createTabBtn("Aimbot", 119)

BtnMain.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
BtnMain.TextColor3 = Color3.fromRGB(255, 255, 255)

local function switchTab(targetTab, targetBtn)
    TabMain.Visible = (targetTab == TabMain)
    TabEsp.Visible = (targetTab == TabEsp)
    TabFruit.Visible = (targetTab == TabFruit)
    TabAimbot.Visible = (targetTab == TabAimbot)
    
    for _, b in ipairs({BtnMain, BtnEsp, BtnFruit, BtnAimbot}) do
        b.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
        b.TextColor3 = Color3.fromRGB(150, 150, 150)
    end
    targetBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    targetBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
end

BtnMain.MouseButton1Click:Connect(function() switchTab(TabMain, BtnMain) end)
BtnEsp.MouseButton1Click:Connect(function() switchTab(TabEsp, BtnEsp) end)
BtnFruit.MouseButton1Click:Connect(function() switchTab(TabFruit, BtnFruit) end)
BtnAimbot.MouseButton1Click:Connect(function() switchTab(TabAimbot, BtnAimbot) end)

local function showToast(msg)
    local t = Instance.new("TextLabel")
    t.Size = UDim2.new(0, 260, 0, 30)
    t.Position = UDim2.new(0.5, -130, 0.85, 0)
    t.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    t.TextColor3 = Color3.fromRGB(255, 255, 0)
    t.TextSize, t.Font = 11, Enum.Font.SourceSansBold
    t.Text = msg
    t.Parent = ScreenGui
    Instance.new("UICorner", t).CornerRadius = UDim.new(0, 0)
    task.delay(2, function() if t then t:Destroy() end end)
end

