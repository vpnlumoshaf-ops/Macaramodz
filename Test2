local function createTabButton(name, posY)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -10, 0, 35)
    btn.Position = UDim2.new(0, 5, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    btn.Text = name
    btn.TextColor3 = Color3.fromRGB(160, 160, 160)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 13
    btn.Parent = TabContainer
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 0)
    return btn
end

local Tab1Btn = createTabButton("Main", 10)
local Tab2Btn = createTabButton("Esp", 55)
local Tab3Btn = createTabButton("Fruit", 100)
local Tab4Btn = createTabButton("Aimbot", 145)

Tab1Btn.BackgroundColor3, Tab1Btn.TextColor3 = Color3.fromRGB(45, 45, 45), Color3.fromRGB(255, 255, 255)

local function switchTab(activeTab, activeBtn)
    TabMainContent.Visible = (activeTab == TabMainContent)
    TabEspContent.Visible = (activeTab == TabEspContent)
    TabFruitContent.Visible = (activeTab == TabFruitContent)
    TabAimbotContent.Visible = (activeTab == TabAimbotContent)
    
    for _, b in ipairs({Tab1Btn, Tab2Btn, Tab3Btn, Tab4Btn}) do
        b.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
        b.TextColor3 = Color3.fromRGB(160, 160, 160)
    end
    activeBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    activeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
end

Tab1Btn.MouseButton1Click:Connect(function() switchTab(TabMainContent, Tab1Btn) end)
Tab2Btn.MouseButton1Click:Connect(function() switchTab(TabEspContent, Tab2Btn) end)
Tab3Btn.MouseButton1Click:Connect(function() switchTab(TabFruitContent, Tab3Btn) end)
Tab4Btn.MouseButton1Click:Connect(function() switchTab(TabAimbotContent, Tab4Btn) end)

local function showToast(msg)
    local t = Instance.new("TextLabel")
    t.Size = UDim2.new(0, 280, 0, 32)
    t.Position = UDim2.new(0.5, -140, 0.82, 0)
    t.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    t.TextColor3 = Color3.fromRGB(255, 255, 0)
    t.TextSize, t.Font = 12, Enum.Font.SourceSansBold
    t.Text = msg
    t.Parent = ScreenGui
    Instance.new("UICorner", t).CornerRadius = UDim.new(0, 0)
    task.delay(2, function() if t then t:Destroy() end end)
end

