local FOVRing = nil
pcall(function()
    FOVRing = Drawing.new("Circle")
    FOVRing.Thickness = 2
    FOVRing.NumSides = 60
    FOVRing.Filled = false
    FOVRing.Color = Color3.fromRGB(0, 255, 0)
    FOVRing.Transparency = 0.8
    FOVRing.Visible = false
end)

local smoothness = 0.25

RunService.RenderStepped:Connect(function()
    if not getgenv().TphatFixLagLoaded then
        if FOVRing then FOVRing.Visible = false end
        return
    end

    local screenSize = Camera.ViewportSize
    local centerScreen = Vector2.new(screenSize.X / 2, screenSize.Y / 2)

    if FOVRing then
        FOVRing.Radius = fovRadiusValue
        FOVRing.Position = centerScreen
        FOVRing.Visible = aimFOVEnabled
    end

    local targetPart = nil
    local shortestDistance = math.huge

    if aimNormalEnabled then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local part = p.Character:FindFirstChild("Head") or p.Character.HumanoidRootPart
                    local dist = (part.Position - Camera.CFrame.Position).Magnitude
                    if dist < shortestDistance then
                        shortestDistance = dist
                        targetPart = part
                    end
                end
            end
        end
    end

    if aimFOVEnabled and not targetPart then
        shortestDistance = fovRadiusValue
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local part = p.Character:FindFirstChild("Head") or p.Character.HumanoidRootPart
                    local screenPoint, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen then
                        local mouseDist = (Vector2.new(screenPoint.X, screenPoint.Y) - centerScreen).Magnitude
                        if mouseDist < shortestDistance then
                            shortestDistance = mouseDist
                            targetPart = part
                        end
                    end
                end
            end
        end
    end

    if targetPart then
        local currentCFrame = Camera.CFrame
        local targetCFrame = CFrame.new(currentCFrame.Position, targetPart.Position)
        Camera.CFrame = currentCFrame:Lerp(targetCFrame, smoothness)
    end

    if (flyKillEnabled or flyManualEnabled) and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local rootPart = LocalPlayer.Character.HumanoidRootPart
        local currentPos = rootPart.Position
        
        rootPart.Velocity = Vector3.new(0, 0, 0)
        rootPart.CFrame = CFrame.new(currentPos.X, currentPos.Y + (flyHeightValue * 0.05), currentPos.Z)

        if flyKillEnabled then
            local closestEnemy = nil
            local minD = math.huge
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    local hum = p.Character:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then
                        local d = (p.Character.HumanoidRootPart.Position - currentPos).Magnitude
                        if d < minD then
                            minD = d
                            closestEnemy = p.Character:FindFirstChild("Head") or p.Character.HumanoidRootPart
                        end
                    end
                end
            end
            if closestEnemy then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, closestEnemy.Position)
            end
        end
    end
end)

