local function createTabButton(name, posY)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -8, 0, 38)
    btn.Position = UDim2.new(0, 4, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
