    if aimPlayerEnabled then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local humanoid = p.Character:FindFirstChildOfClass("Humanoid")
                if humanoid and humanoid.Health > 0 then
                    local pos = p.Character.HumanoidRootPart.Position
                    local distance = (pos - Camera.CFrame.Position).Magnitude
                    if distance < shortestDistance then
                        shortestDistance = distance
                        -- Ngắm vào phần Ngực/Đầu (Head hoặc UpperTorso) để chuẩn xác nhất
                        targetPart = p.Character:FindFirstChild("Head") or p.Character.HumanoidRootPart
                    end
                end
            end
        end
    end

    -- 2. Nếu không có Player hoặc tắt Aim Player, tìm Mob nếu bật Aim Mob
    if aimMobEnabled and not targetPart then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
                local isPlayer = false
                for _, p in ipairs(Players:GetPlayers()) do
                    if p.Character == obj then
                        isPlayer = true
                        break
                    end
                end
                
                if not isPlayer then
                    local humanoid = obj.Humanoid
                    if humanoid.Health > 0 then
                        local pos = obj.HumanoidRootPart.Position
                        local distance = (pos - Camera.CFrame.Position).Magnitude
                        if distance < shortestDistance then
                            shortestDistance = distance
                            targetPart = obj:FindFirstChild("Head") or obj.HumanoidRootPart
                        end
                    end
                end
            end
        end
    end

    -- 3. Thực hiện khóa mục tiêu mượt mà KHÔNG làm rời camera khỏi nhân vật
    if targetPart then
        local currentCFrame = Camera.CFrame
        -- Tạo góc nhìn mới hướng về mục tiêu nhưng giữ nguyên vị trí mắt (Camera position) của bạn
        local targetCFrame = CFrame.new(currentCFrame.Position, targetPart.Position)
        
        -- Dùng CFrame.Lerp để xoay camera từ từ, tạo độ mượt (không bị giật hay văng góc nhìn)
        Camera.CFrame = currentCFrame:Lerp(targetCFrame, smoothness)
    end
end)

