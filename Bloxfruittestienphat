-- 2. HỆ THỐNG ESP OBJECT (HIỂN THỊ TÊN CÁC VẬT THỂ)
local objectTexts = {}

local function clearObjectESP()
    for _, txt in pairs(objectTexts) do
        txt:Remove()
    end
    objectTexts = {}
end

-- 3. VÒNG LẶP RENDER VÀ QUÉT VẬT THỂ
RunService.RenderStepped:Connect(function()
    -- Cập nhật Object ESP (Tên vật thể xung quanh)
    if settingsState.ObjectESP then
        clearObjectESP()
        for _, obj in ipairs(Workspace:GetChildren()) do
            if obj:IsA("Model") or obj:IsA("BasePart") then
                local pos = obj:IsA("Model") and (obj.PrimaryPart and obj.PrimaryPart.Position or obj:GetAttribute("Pivot")) or obj.Position
                if pos then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(pos)
                    if onScreen then
                        local text = Drawing.new("Text")
                        text.Text = obj.Name
                        text.Size = 14
                        text.Center = true
                        text.Outline = true
                        text.Color = Color3.fromRGB(255, 255, 0)
                        text.Position = Vector2.new(screenPos.X, screenPos.Y)
                        text.Visible = true
                        table.insert(objectTexts, text)
                    end
                end
            end
        end
    else
        clearObjectESP()
    end
end)

