local playerIndex = 1
local function cycleTargetPlayer()
    local allPlayers = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(allPlayers, p)
        end
    end
    if #allPlayers > 0 then
        playerIndex = playerIndex + 1
        if playerIndex > #allPlayers then playerIndex = 1 end
        selectedTargetPlayer = allPlayers[playerIndex]
        TargetLabel.Text = "Mục tiêu: " .. selectedTargetPlayer.Name
    else
        TargetLabel.Text = "Không có người chơi khác"
        selectedTargetPlayer = nil
    end
end

