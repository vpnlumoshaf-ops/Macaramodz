-- Fix Lag Mạnh + Brightness + No Fog + Xóa Animation
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local function isCharacter(obj)
    local char = LocalPlayer.Character
    return char and obj:IsDescendantOf(char)
end

local function clean(obj)
    if isCharacter(obj) then return end

    if obj:IsA("SpecialMesh") or obj:IsA("FileMesh") then
        pcall(function() obj:Destroy() end)
        return
    end

    if obj:IsA("Texture") or obj:IsA("Decal") or obj:IsA("SurfaceAppearance") then
        pcall(function() obj:Destroy() end)
        return
    end

    if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")
    or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles")
    or obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then
        pcall(function() obj:Destroy() end)
        return
    end

    -- Xóa Animation
    if obj:IsA("Animation") or obj:IsA("AnimationClip") or obj:IsA("AnimationController") then
        pcall(function() obj:Destroy() end)
        return
    end

    if obj:IsA("BasePart") then
        pcall(function()
            obj.Material = Enum.Material.SmoothPlastic
            obj.Reflectance = 0
        end)
    end
end

for _, v in pairs(workspace:GetDescendants()) do
    clean(v)
end

workspace.DescendantAdded:Connect(clean)

pcall(function()
    local Lighting = game:GetService("Lighting")
    Lighting.GlobalShadows = false
    Lighting.FogEnd = 9e9
    Lighting.FogStart = 0
    Lighting.Brightness = 2
    settings().Rendering.QualityLevel = 1
end)
