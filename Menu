-- Kiểm tra chống spam: Nếu menu đã tồn tại rồi thì không tạo mới nữa
if game.CoreGui:FindFirstChild("TienPhatXCheatGui") then
    return
end

-- Tạo ScreenGui chính gắn vào CoreGui
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "TienPhatXCheatGui"
ScreenGui.Parent = game.CoreGui
ScreenGui.ResetOnSpawn = false

local MainFrame = Instance.new("Frame")
MainFrame.Name = "MainFrame"
MainFrame.Parent = ScreenGui
MainFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
MainFrame.Position = UDim2.new(0.5, -100, 0.5, -75)
MainFrame.Size = UDim2.new(0, 220, 0, 160)
MainFrame.Active = true
MainFrame.Draggable = true -- Cho phép kéo thả menu trên Delta X

local Title = Instance.new("TextLabel")
Title.Name = "Title"
Title.Parent = MainFrame
Title.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
Title.Size = UDim2.new(1, 0, 0, 30)
Title.Font = Enum.Font.SourceSansBold
Title.Text = "Tiến Phát XCheat"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.TextSize = 16

-- Nút tính năng mẫu trong menu
local ActionBtn = Instance.new("TextButton")
ActionBtn.Name = "ActionBtn"
ActionBtn.Parent = MainFrame
ActionBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
ActionBtn.Position = UDim2.new(0.1, 0, 0.35, 0)
ActionBtn.Size = UDim2.new(0.8, 0, 0, 35)
ActionBtn.Font = Enum.Font.SourceSans
ActionBtn.Text = "Tính năng 1 (Off)"
ActionBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
ActionBtn.TextSize = 14

local active = false
ActionBtn.MouseButton1Click:Connect(function()
    active = not active
    if active then
        ActionBtn.Text = "Tính năng 1 (On)"
        ActionBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
    else
        ActionBtn.Text = "Tính năng 1 (Off)"
        ActionBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    end
end)

