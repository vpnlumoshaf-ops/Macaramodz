local function updateTargetList()
    for _, v in ipairs(TargetListContainer:GetChildren()) do
        if v:IsA("TextButton") then v:Destroy() end
    end
    local yOffset = 0
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 0, 28)
            btn.Position = UDim2.new(0, 0, 0, yOffset)
            btn.BackgroundColor3 = (selectedTargetPlayer == player) and Color3.fromRGB(0, 150, 80) or Color3.fromRGB(45, 45, 45)
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            btn.TextSize = 11
            btn.Font = Enum.Font.SourceSansBold
            btn.Text = player.Name .. (player.Team and (" [" .. player.Team.Name .. "]") or "")
            btn.Parent = TargetListContainer

            local c = Instance.new("UICorner")
            c.CornerRadius = UDim.new(0, 4)
            c.Parent = btn

            btn.MouseButton1Click:Connect(function()
                selectedTargetPlayer = player
                SelectedTargetLabel.Text = "Target Đang Chọn: " .. player.Name
                updateTargetList()
            end)
            yOffset = yOffset + 32
        end
    end
end

