-- Hàm xóa sương mù chung
local function RemoveFog()
    pcall(function()
        Lighting.FogEnd = 999999
        if Lighting:FindFirstChild("Atmosphere") then
            Lighting.Atmosphere.Density = 0
        end
    end)
end

-- Hàm xóa trang phục (Đưa nhân vật về dạng mặc định cơ bản hoặc xóa các phụ kiện rườm rà)
local function RemoveOutfits()
    pcall(function()
        if LocalPlayer.Character then
            for _, v in pairs(LocalPlayer.Character:GetChildren()) do
                if v:IsA("Accessory") or v:IsA("Clothing") or v:IsA("ShirtGraphic") then
                    v:Destroy()
                end
            end
        end
    end)
end

-- Hàm xóa Texture / Material nặng
local function RemoveTextures()
    pcall(function()
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("Texture") or v:IsA("Decal") then
                v:Destroy()
            elseif v:IsA("BasePart") then
                v.Material = Enum.Material.SmoothPlastic
                v.Reflectance = 0
            end
        end
    end)
end

-- Xử lý nút NHẸ: Xóa sương mù, xóa trang phục
BtnNhe.MouseButton1Click:Connect(function()
    RemoveFog()
    RemoveOutfits()
    FixLagBtn.Text = "Fix Lag: Nhẹ (On)"
    FixLagBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
    ModeFrame.Visible = false
end)

-- Xử lý nút TRUNG BÌNH: Xóa sương mù, xóa trang phục, bỏ texture
BtnTrungBinh.MouseButton1Click:Connect(function()
    RemoveFog()
    RemoveOutfits()
    RemoveTextures()
    FixLagBtn.Text = "Fix Lag: Trung Bình (On)"
    FixLagBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
    ModeFrame.Visible = false
end)

