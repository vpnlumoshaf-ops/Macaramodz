-- Nút tròn nổi trên màn hình để mở/tắt menu (Mặc định hiển thị chữ On)
local ToggleGui = Instance.new("ScreenGui")
ToggleGui.Name = "TienPhatToggleGui"
ToggleGui.Parent = game.CoreGui

local OpenBtn = Instance.new("TextButton")
OpenBtn.Parent = ToggleGui
OpenBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
OpenBtn.Position = UDim2.new(0, 20, 0.5, -20)
OpenBtn.Size = UDim2.new(0, 45, 0, 40)
OpenBtn.Font = Enum.Font.SourceSansBold
OpenBtn.Text = "On"
OpenBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
OpenBtn.TextSize = 14
OpenBtn.Draggable = true

local isOpen = true

-- Hàm ẩn/hiện menu chung
local function ToggleMenu(state)
    isOpen = state
    MainFrame.Visible = isOpen
    if isOpen then
        OpenBtn.Text = "On"
        OpenBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
    else
        OpenBtn.Text = "Off"
        OpenBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    end
end

-- Bấm nút tròn nổi ngoài màn hình
OpenBtn.MouseButton1Click:Connect(function()
    ToggleMenu(not isOpen)
end)

-- Bấm nút trừ (-) trên bảng để ẩn menu
MinBtn.MouseButton1Click:Connect(function()
    ToggleMenu(false)
end)

-- Bấm nút X trên bảng để xoá hẳn menu khỏi game
CloseBtn.MouseButton1Click:Connect(function()
    ScreenGui:Destroy()
    ToggleGui:Destroy()
end)
ActionBtn.Size = UDim2.new(0.8, 0, 0, 35)
ActionBtn.Font = Enum.Font.SourceSans
