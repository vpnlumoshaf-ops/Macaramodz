applyFixLag(true)

local espCache = {}
local fruitEspCache = {}
local islandEspCache = {}
local weaponScannerCache = {}
local camera = Workspace.CurrentCamera

local function clearAllESP()
    for _, elements in pairs(espCache) do
        if elements.Box then elements.Box.Visible = false end
        if elements.Line then elements.Line.Visible = false end
    end
    for _, elements in pairs(fruitEspCache) do
        if elements.Text then elements.Text.Visible = false end
    end
    for _, elements in pairs(islandEspCache) do
        if elements.Text then elements.Text.Visible = false end
    end
    for _, textObj in pairs(weaponScannerCache) do
        if textObj then textObj.Visible = false end
    end
end

task.spawn(function()
    while true do
        task.wait(1)
        pcall(function()
            local data = LocalPlayer:FindFirstChild("Data")
            local points = data and data:FindFirstChild("Points")
            if points and points.Value > 0 then
                local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                if remotes and remotes:FindFirstChild("CommF_") then
                    if Config.AutoStatMelee then remotes.CommF_:InvokeServer("AddPoint", "Melee", Config.StatAmount) end
                    if Config.AutoStatDefense then remotes.CommF_:InvokeServer("AddPoint", "Defense", Config.StatAmount) end
                    if Config.AutoStatSword then remotes.CommF_:InvokeServer("AddPoint", "Sword", Config.StatAmount) end
                    if Config.AutoStatDevilFruit then remotes.CommF_:InvokeServer("AddPoint", "Demon Fruit", Config.StatAmount) end
                end
            end
        end)
    end
end)

task.spawn(function()
    while true do
        task.wait(3)
        pcall(function()
            if Config.AutoStoreFruit then
                local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                if remotes and remotes:FindFirstChild("CommF_") then
                    local backpack = LocalPlayer:FindFirstChild("Backpack")
                    local char = LocalPlayer.Character
                    
                    local function checkAndStore(tool)
                        if tool and tool:IsA("Tool") and (string.find(tool.Name, "Fruit") or tool:FindFirstChild("Handle")) then
                            remotes.CommF_:InvokeServer("StoreFruit", tool.Name)
                        end
                    end

                    if backpack then
                        for _, item in ipairs(backpack:GetChildren()) do
                            checkAndStore(item)
                        end
                    end
                    if char then
                        for _, item in ipairs(char:GetChildren()) do
                            checkAndStore(item)
                        end
                    end
                end
            end
        end)
    end
end)

-- Vòng lặp Auto Farm và xử lý nhiệm vụ dựa trên tọa độ đảo hiện tại
RunService.RenderStepped:Connect(function(dt)
    if not ScreenGui.Parent then 
        clearAllESP()
        return 
    end

    if tick() % 3 < 0.1 then
        updateWeaponButtons()
    end

    local targetFruitHandle = nil
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("Tool") and (string.find(obj.Name, "Fruit") or obj:FindFirstChild("Handle")) then
            local handle = obj:FindFirstChild("Handle") or obj
            if handle then
                targetFruitHandle = handle
                break
            end
        end
    end

    if Config.InstantTpFruit and targetFruitHandle then
        pcall(function()
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                char.HumanoidRootPart.CFrame = targetFruitHandle.CFrame + Vector3.new(0, 3, 0)
            end
        end)
    end

    if Config.FlyToIslandState and Config.IslandPos then
        pcall(function()
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local hrp = char.HumanoidRootPart
                local targetPos = Config.IslandPos + Vector3.new(0, 50, 0)
                local currentPos = hrp.Position
                local distance = (targetPos - currentPos).Magnitude
                
                if distance > 10 then
                    local direction = (targetPos - currentPos).Unit
                    hrp.CFrame = CFrame.new(currentPos + direction * (Config.FlySpeed * dt), targetPos)
                    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                end
            end
        end)
    end

    if Config.ShowESP then
        local folderEnemies = Workspace:FindFirstChild("Enemies") or Workspace:FindFirstChild("MobFolders")
        local activeFound = {}
        if folderEnemies then
            for _, mob in ipairs(folderEnemies:GetChildren()) do
                local hrp = mob:FindFirstChild("HumanoidRootPart")
                local hum = mob:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 then
                    if not espCache[mob] then
                        local box = Drawing.new("Square")
                        box.Visible = false; box.Color = Color3.fromRGB(0, 255, 0); box.Thickness = 1; box.Filled = false
                        local line = Drawing.new("Line")
                        line.Visible = false; line.Color = Color3.fromRGB(255, 255, 255); line.Thickness = 1
                        espCache[mob] = {Box = box, Line = line}
                    end

                    local vector, onScreen = camera:WorldToViewportPoint(hrp.Position)
                    if onScreen then
                        local dist = (camera.CFrame.Position - hrp.Position).Magnitude
                        local scale = math.clamp(400 / dist, 0.2, 1.5)
                        local boxW, boxH = 18 * scale, 30 * scale
                        
                        local boxObj = espCache[mob].Box
                        boxObj.Size = Vector2.new(boxW, boxH)
                        boxObj.Position = Vector2.new(vector.X - boxW/2, vector.Y - boxH/2)
                        boxObj.Visible = true

                        local lineObj = espCache[mob].Line
                        lineObj.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
                        lineObj.To = Vector2.new(vector.X, vector.Y)
                        lineObj.Visible = true
                        
                        activeFound[mob] = true
                    else
                        espCache[mob].Box.Visible = false; espCache[mob].Line.Visible = false
                    end
                end
            end
        end
        for m, elements in pairs(espCache) do
            if not activeFound[m] then
                if elements.Box then elements.Box.Visible = false end
                if elements.Line then elements.Line.Visible = false end
            end
        end
    else
        for _, elements in pairs(espCache) do
            if elements.Box then elements.Box.Visible = false end
            if elements.Line then elements.Line.Visible = false end
        end
    end

    local foundFruitsNames = {}
    if Config.ShowFruitESP then
        local activeFruits = {}
        for _, obj in ipairs(Workspace:GetChildren()) do
            if obj:IsA("Tool") and (string.find(obj.Name, "Fruit") or obj:FindFirstChild("Handle")) then
                local handle = obj:FindFirstChild("Handle") or obj
                if handle then
                    if not fruitEspCache[obj] then
                        local tObj = Drawing.new("Text")
                        tObj.Visible = false; tObj.Size = 14; tObj.Color = Color3.fromRGB(255, 0, 0); tObj.Center = true; tObj.Outline = true
                        fruitEspCache[obj] = {Text = tObj}
                    end

                    local vector, onScreen = camera:WorldToViewportPoint(handle.Position)
                    if onScreen then
                        local dist = math.floor((camera.CFrame.Position - handle.Position).Magnitude)
                        local txtObj = fruitEspCache[obj].Text
                        txtObj.Text = "🍎 [" .. obj.Name .. "] (" .. dist .. "m)"
                        txtObj.Position = Vector2.new(vector.X, vector.Y)
                        txtObj.Visible = true
                        activeFruits[obj] = true
                    else
                        fruitEspCache[obj].Text.Visible = false
                    end
                    table.insert(foundFruitsNames, obj.Name)
                end
            end
        end
        for obj, elements in pairs(fruitEspCache) do
            if not activeFruits[obj] then
                if elements.Text then elements.Text.Visible = false end
            end
        end
    else
        for _, elements in pairs(fruitEspCache) do
            if elements.Text then elements.Text.Visible = false end
        end
    end

    if Config.FruitNotifier then
        FruitNotifLabel.Visible = true
        if #foundFruitsNames > 0 then
            FruitNotifLabel.Text = "Đang có trái ác quỷ: " .. table.concat(foundFruitsNames, ", ")
            FruitNotifLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
        else
            FruitNotifLabel.Text = "Đang có trái ác quỷ: Không có"
            FruitNotifLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
        end
    else
        FruitNotifLabel.Visible = false
    end

    if Config.ShowIslandESP then
        local mapFolder = Workspace:FindFirstChild("_Map") or Workspace:FindFirstChild("Map")
        local activeIslands = {}
        if mapFolder then
            for _, island in ipairs(mapFolder:GetChildren()) do
                if island:IsA("Model") then
                    local primaryPart = island.PrimaryPart or island:FindFirstChildWhichIsA("BasePart")
                    if primaryPart then
                        if not islandEspCache[island] then
                            local tObj = Drawing.new("Text")
                            tObj.Visible = false; tObj.Size = 15; tObj.Color = Color3.fromRGB(0, 255, 255); tObj.Center = true; tObj.Outline = true
                            islandEspCache[island] = {Text = tObj}
                        end

                        local vector, onScreen = camera:WorldToViewportPoint(primaryPart.Position)
                        if onScreen then
                            local dist = math.floor((camera.CFrame.Position - primaryPart.Position).Magnitude)
                            local txtObj = islandEspCache[island].Text
                            txtObj.Text = "🏝️ " .. island.Name .. " (" .. dist .. "m)"
                            txtObj.Position = Vector2.new(vector.X, vector.Y)
                            txtObj.Visible = true
                            activeIslands[island] = true
                        else
                            islandEspCache[island].Text.Visible = false
                        end
                    end
                end
            end
        end
        for island, elements in pairs(islandEspCache) do
            if not activeIslands[island] then
                if elements.Text then elements.Text.Visible = false end
            end
        end
    else
        for _, elements in pairs(islandEspCache) do
            if elements.Text then elements.Text.Visible = false end
        end
    end

    if Config.ShowWeaponScanner then
        local activePlayers = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local pChar = plr.Character
                local pHrp = pChar.HumanoidRootPart
                local pHum = pChar:FindFirstChildOfClass("Humanoid")
                
                if pHum and pHum.Health > 0 then
                    local activeTool = "Tay không"
                    local toolInHand = pChar:FindFirstChildOfClass("Tool")
                    if toolInHand then activeTool = toolInHand.Name end

                    if not weaponScannerCache[plr] then
                        local tObj = Drawing.new("Text")
                        tObj.Visible = false; tObj.Size = 13; tObj.Color = Color3.fromRGB(255, 128, 255); tObj.Center = true; tObj.Outline = true
                        weaponScannerCache[plr] = tObj
                    end

                    local vector, onScreen = camera:WorldToViewportPoint(pHrp.Position + Vector3.new(0, 3, 0))
                    if onScreen then
                        local txtObj = weaponScannerCache[plr]
                        txtObj.Text = "[" .. plr.Name .. "] ⚔️ " .. activeTool
                        txtObj.Position = Vector2.new(vector.X, vector.Y)
                        txtObj.Visible = true
                        activePlayers[plr] = true
                    else
                        weaponScannerCache[plr].Visible = false
                    end
                end
            end
        end
        for p, tObj in pairs(weaponScannerCache) do
            if not activePlayers[p] then tObj.Visible = false end
        end
    else
        for _, tObj in pairs(weaponScannerCache) do
            tObj.Visible = false
        end
    end

    if Config.FlyToFruit and targetFruitHandle then
        pcall(function()
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local hrp = char.HumanoidRootPart
                hrp.CFrame = CFrame.new(hrp.Position:Lerp(targetFruitHandle.Position + Vector3.new(0, 3, 0), 0.2))
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            end
        end)
    end

    -- LOGIC AUTO FARM KẾT HỢP KIỂM TRA NHIỆM VỤ DỰA TRÊN TỌA ĐỘ ĐẢO
    if Config.AutoFarm then
        pcall(function()
            if not hasActiveQuest() then
                checkAndGetQuestClean()
                task.wait(0.5)
            end

            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") then
                local hrp = char.HumanoidRootPart
                local hum = char:FindFirstChildOfClass("Humanoid")

                local currentTool = char:FindFirstChildOfClass("Tool")
                if not currentTool or (Config.SelectedWeapon ~= "Tự động chọn" and currentTool.Name ~= Config.SelectedWeapon) then
                    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack") or LocalPlayer.Backpack
                    if backpack then
                        local targetTool = nil
                        for _, item in ipairs(backpack:GetChildren()) do
                            if item:IsA("Tool") then
                                if Config.SelectedWeapon == "Tự động chọn" then
                                    targetTool = item; break
                                elseif item.Name == Config.SelectedWeapon then
                                    targetTool = item; break
                                end
                            end
                        end
                        if targetTool then hum:EquipTool(targetTool) end
                    end
                end

                local questMobName = getCurrentQuestMobName()
                local folderEnemies = Workspace:FindFirstChild("Enemies") or Workspace:FindFirstChild("MobFolders")
                local targetMob = nil
                local shortestDist = math.huge
                
                if folderEnemies and questMobName then
                    for _, mob in ipairs(folderEnemies:GetChildren()) do
                        local mobHrp = mob:FindFirstChild("HumanoidRootPart")
                        local mobHum = mob:FindFirstChildOfClass("Humanoid")
                        if mobHrp and mobHum and mobHum.Health > 0 then
                            if string.find(mob.Name:lower(), questMobName:lower()) then
                                local d = (mobHrp.Position - hrp.Position).Magnitude
                                if d < shortestDist then
                                    shortestDist = d
                                    targetMob = mob
                                end
                            end
                        end
                    end
                end

                if not targetMob and folderEnemies then
                    for _, mob in ipairs(folderEnemies:GetChildren()) do
                        local mobHrp = mob:FindFirstChild("HumanoidRootPart")
                        local mobHum = mob:FindFirstChildOfClass("Humanoid")
                        if mobHrp and mobHum and mobHum.Health > 0 then
                            local d = (mobHrp.Position - hrp.Position).Magnitude
                            if d < shortestDist then
                                shortestDist = d
                                targetMob = mob
                            end
                        end
                    end
                end

                if targetMob and targetMob:FindFirstChild("HumanoidRootPart") then
                    local mHrp = targetMob.HumanoidRootPart
                    local mHum = targetMob:FindFirstChildOfClass("Humanoid")

                    hrp.CFrame = CFrame.new(mHrp.Position + Vector3.new(0, 4, 0))
                    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)

                    if mHum and mHum.Health > 0 then
                        pcall(function()
                            local activeTool = char:FindFirstChildOfClass("Tool")
                            if activeTool then
                                activeTool:Activate()
                            end
                            VirtualUser:Button1Down(Vector2.new(100, 100), camera.CFrame)
                            task.wait()
                            VirtualUser:Button1Up(Vector2.new(100, 100), camera.CFrame)
                        end)
                    end
                end
            end
        end)
    end
end)
