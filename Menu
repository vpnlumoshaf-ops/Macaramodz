AutoEggBtn.MouseButton1Click:Connect(function()
    EggListFrame.Visible = true
    for _, v in pairs(ScrollEggs:GetChildren()) do
        if v:IsA("TextButton") then v:Destroy() end
    end
    
    local count = 0
    -- Lọc chuẩn chỉ tìm trứng, loại bỏ máy hợp nhất / máy roll
    for _, obj in pairs(workspace:GetDescendants()) do
        if (obj:IsA("Model") or obj:IsA("BasePart")) then
            local nameLower = string.lower(obj.Name)
            -- Kiểm tra từ khóa trứng thực sự và tránh máy móc
            if (nameLower:find("egg") or nameLower:find("trứng")) and not nameLower:find("machine") and not nameLower:find("máy") and not nameLower:find("roll") and not nameLower:find("upgrade") then
                count = count + 1
                local btn = Instance.new("TextButton")
                btn.Parent = ScrollEggs
                btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
                btn.Position = UDim2.new(0.05, 0, 0, (count - 1) * 40 + 5)
                btn.Size = UDim2.new(0.9, 0, 0, 35)
                btn.Font = Enum.Font.SourceSansBold
                btn.Text = "Trứng: " .. obj.Name
                btn.TextColor3 = Color3.fromRGB(255, 255, 255)
                btn.TextSize = 13
                
                local targetObj = obj
                btn.MouseButton1Click:Connect(function()
                    EggListFrame.Visible = false
                    local char = LocalPlayer.Character
                    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
                    local root = char.HumanoidRootPart
                    local targetPos = targetObj:IsA("Model") and targetObj:GetPivot().Position or targetObj.Position
                    local safePos = root.Position
                    
                    -- BAY MƯỢT TỚI MỤC TIÊU (CHỐNG KICK ANTICHEAT) THAY VÌ TELEPORT
                    task.spawn(function()
                        local tempBv = Instance.new("BodyVelocity")
                        tempBv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                        tempBv.Parent = root
                        
                        -- Bay nhanh dần đến sát quả trứng
                        while (root.Position - targetPos).Magnitude > 5 and char.Parent do
                            local dir = (targetPos - root.Position).Unit
                            tempBv.Velocity = dir * 120 -- Tốc độ bay mượt không bị anticheat phát hiện
                            RunService.RenderStepped:Wait()
                        end
                        tempBv:Destroy()
                        
                        -- Giữ phím E để lấy trứng
                        pcall(function() game:GetService("VirtualInputManager"):SendKeyEvent(true, Enum.KeyCode.E, false, game) end)
                        
                        -- Vút thẳng lên trời né boss
                        local upBv = Instance.new("BodyVelocity")
                        upBv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                        upBv.Velocity = Vector3.new(0, 180, 0)
                        upBv.Parent = root
                        task.wait(1.2) -- Thời gian ôm trứng & né boss
                        upBv:Destroy()
                        
                        -- Nhả phím E
                        pcall(function() game:GetService("VirtualInputManager"):SendKeyEvent(false, Enum.KeyCode.E, false, game) end)
                        
                        -- Bay mượt về lại Safe Zone cũ
                        local backBv = Instance.new("BodyVelocity")
                        backBv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                        backBv.Parent = root
                        while (root.Position - safePos).Magnitude > 5 and char.Parent do
                            local dir = (safePos - root.Position).Unit
                            backBv.Velocity = dir * 140
                            RunService.RenderStepped:Wait()
                        end
                        backBv:Destroy()
                    end)
                end)
            end
        end
    end
    ScrollEggs.CanvasSize = UDim2.new(0, 0, 0, count * 40 + 10)
end)

