-- 3. HỆ THỐNG XỬ LÝ CHÍNH
local espCache = {}
local weaponScannerCache = {}

local function clearAllESP()
    for _, elements in pairs(espCache) do
        if elements.Box then elements.Box.Visible = false end
        if elements.Line then elements.Line.Visible = false end
    end
    for _, textObj in pairs(weaponScannerCache) do
        if textObj then textObj.Visible = false end
    end
end

local lastQuestTick = 0
local camera = Workspace.CurrentCamera

local function getQuestNPCData()
    local level = LocalPlayer.Data.Level.Value
    if level >= 10 and level < 15 then
        return "Monkey", CFrame.new(-1598, 37, 153), {"StartQuest", "Monkey", 1}
    elseif level >= 15 and level < 30 then
        return "Gorilla", CFrame.new(-1598, 37, 153), {"StartQuest", "Gorilla", 1}
    elseif level >= 30 and level < 60 then
        return "Pirate", CFrame.new(1045, 16, 1330), {"StartQuest", "Pirate", 1}
    elseif level >= 60 and level < 90 then
        return "Brute", CFrame.new(1113, 17, 4363), {"StartQuest", "Brute", 1}
    elseif level >= 90 and level < 120 then
        return "DesertBandit", CFrame.new(896, 7, 4390), {"StartQuest", "DesertBandit", 1}
    elseif level >= 120 and level < 150 then
        return "SnowBandit", CFrame.new(1385, 87, -1298), {"StartQuest", "SnowBandit", 1}
    else
        return "Bandit", CFrame.new(1059, 17, 1179), {"StartQuest", "Bandit", 1}
    end
end

RunService.RenderStepped:Connect(function()
    if not ScreenGui.Parent then 
        clearAllESP()
        return 
    end

    if tick() % 3 < 0.1 then
        updateWeaponButtons()
    end

    -- ESP Quái
    if Config.ShowESP then
        local folderEnemies = Workspace:FindFirstChild("Enemies") or Workspace:FindFirstChild("MobFolders")
        local activeFound = {}
        if folderEnemies then
            for _, mob in ipairs(folderEnemies:GetChildren()) do
                local hrp = mob:FindFirstChild("HumanoidRootPart")
                local hum = mob:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 then
                    if not espCache[mob] then
                        local box = Drawing.new("Square")
                        box.Visible = false
                        box.Color = Color3.fromRGB(255, 50, 50)
                        box.Thickness = 1
                        box.Filled = false

                        local line = Drawing.new("Line")
                        line.Visible = false
                        line.Color = Color3.fromRGB(255, 170, 0)
                        line.Thickness = 1

                        espCache[mob] = {Box = box, Line = line}
                    end

                    local vector, onScreen = camera:WorldToViewportPoint(hrp.Position)
                    if onScreen then
                        local scale = math.clamp(600 / (camera.CFrame.Position - hrp.Position).Magnitude, 0.3, 2)
                        local boxW, boxH = 26 * scale, 42 * scale
                        
                        local boxObj = espCache[mob].Box
                        boxObj.Size = Vector2.new(boxW, boxH)
                        boxObj.Position = Vector2.new(vector.X - boxW/2, vector.Y - boxH/2)
                        boxObj.Visible = true

                        local lineObj = espCache[mob].Line
                        lineObj.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
                        lineObj.To = Vector2.new(vector.X, vector.Y)
                        lineObj.Visible = true
                        
                        activeFound[mob] = true
                    else
                        espCache[mob].Box.Visible = false
                        espCache[mob].Line.Visible = false
                    end
                end
            end
        end
        for m, elements in pairs(espCache) do
            if not activeFound[m] then
                if elements.Box then elements.Box.Visible = false end
                if elements.Line then elements.Line.Visible = false end
            end
        end
    else
        for _, elements in pairs(espCache) do
            if elements.Box then elements.Box.Visible = false end
            if elements.Line then elements.Line.Visible = false end
        end
    end

    -- Weapon Scanner người chơi khác
    if Config.ShowWeaponScanner then
        local activePlayers = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local pChar = plr.Character
                local pHrp = pChar.HumanoidRootPart
                local pHum = pChar:FindFirstChildOfClass("Humanoid")
                
                if pHum and pHum.Health > 0 then
                    local activeTool = "Tay không"
                    local toolInHand = pChar:FindFirstChildOfClass("Tool")
                    if toolInHand then activeTool = toolInHand.Name end

                    if not weaponScannerCache[plr] then
                        local tObj = Drawing.new("Text")
                        tObj.Visible = false
                        tObj.Size = 13
                        tObj.Color = Color3.fromRGB(0, 255, 255)
                        tObj.Center = true
                        tObj.Outline = true
                        weaponScannerCache[plr] = tObj
                    end

                    local vector, onScreen = camera:WorldToViewportPoint(pHrp.Position + Vector3.new(0, 3, 0))
                    if onScreen then
                        local txtObj = weaponScannerCache[plr]
                        txtObj.Text = "[" .. plr.Name .. "] ⚔️ " .. activeTool
                        txtObj.Position = Vector2.new(vector.X, vector.Y)
                        txtObj.Visible = true
                        activePlayers[plr] = true
                    else
                        weaponScannerCache[plr].Visible = false
                    end
                end
            end
        end
        for p, tObj in pairs(weaponScannerCache) do
            if not activePlayers[p] then tObj.Visible = false end
        end
    else
        for _, tObj in pairs(weaponScannerCache) do tObj.Visible = false end
    end

    -- 4. AUTO FARM, GÔM & FREEZE QUÁI, NHẬN Q & AUTO CLICK SIÊU TỐC
    if Config.AutoFarm then
        pcall(function()
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") then
                local hrp = char.HumanoidRootPart
                local hum = char:FindFirstChildOfClass("Humanoid")

                -- Trang bị vũ khí đã chọn
                local currentTool = char:FindFirstChildOfClass("Tool")
                if not currentTool or (Config.SelectedWeapon ~= "Tự động chọn" and currentTool.Name ~= Config.SelectedWeapon) then
                    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
                    if backpack then
                        local targetTool = nil
                        for _, item in ipairs(backpack:GetChildren()) do
                            if item:IsA("Tool") then
                                if Config.SelectedWeapon == "Tự động chọn" then
                                    targetTool = item
                                    break
                                elseif item.Name == Config.SelectedWeapon then
                                    targetTool = item
                                    break
                                end
                            end
                        end
                        if targetTool then
                            hum:EquipTool(targetTool)
                        end
                    end
                end

                -- Kiểm tra bảng nhiệm vụ
                local mainGui = LocalPlayer.PlayerGui:FindFirstChild("Main")
                local questGui = mainGui and mainGui:FindFirstChild("Quest")
                local mobNameNeeded, npcPos, questArgs = getQuestNPCData()

                if questGui and not questGui.Visible then
                    if (hrp.Position - npcPos.Position).Magnitude > 6 then
                        hrp.CFrame = CFrame.new(npcPos.Position + Vector3.new(0, 4, 0))
                    else
                        if tick() - lastQuestTick > 1.0 then
                            lastQuestTick = tick()
                            local commF = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
                            if commF then
                                commF:InvokeServer(unpack(questArgs))
                            end
                        end
                    end
                    return
                end

                -- Tích hợp Gôm quái (Bring Mob) trong 100m và Đóng băng (Freeze) đứng im trên đầu nhân vật
                local targetMob = nil
                local shortestDist = math.huge
                local folderEnemies = Workspace:FindFirstChild("Enemies") or Workspace:FindFirstChild("MobFolders")
                
                if folderEnemies then
                    for _, mob in ipairs(folderEnemies:GetChildren()) do
                        local mobHrp = mob:FindFirstChild("HumanoidRootPart")
                        local mobHum = mob:FindFirstChildOfClass("Humanoid")
                        if mobHrp and mobHum and mobHum.Health > 0 then
                            local d = (mobHrp.Position - hrp.Position).Magnitude
                            if d < 100 then
                                mobHrp.CFrame = hrp.CFrame + Vector3.new(0, 5, 0)
                                mobHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                                mobHrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                                if mobHum:FindFirstChild("Animator") then
                                    pcall(function() mobHum.Animator:Destroy() end)
                                end
                            end
                            
                            if d < shortestDist then
                                shortestDist = d
                                targetMob = mob
                            end
                        end
                    end
                end

                if targetMob then
                    local mHrp = targetMob.HumanoidRootPart
                    hrp.CFrame = mHrp.CFrame + Vector3.new(0, 6, 0)

                    -- Auto Click siêu tốc độ cao đánh liên tục không ngừng nghỉ
                    pcall(function()
                        local tool = char:FindFirstChildOfClass("Tool")
                        if tool then
                            tool:Activate()
                        end
                        VirtualUser:Button1Down(Vector2.new(0,0), camera.CFrame)
                        task.spawn(function()
                            VirtualUser:Button1Up(Vector2.new(0,0), camera.CFrame)
                        end)
                    end)
                end
            end
        end)
    end
end)
