local espBoxes = {}

local function createESPBox(player)
    local box = Drawing.new("Square")
    box.Visible = false
    box.Color = currentBoxColor
    box.Thickness = 1.5
    box.Filled = false
    espBoxes[player] = box
end

local function removeESPBox(player)
    if espBoxes[player] then
        espBoxes[player]:Remove()
        espBoxes[player] = nil
    end
end

Players.PlayerAdded:Connect(createESPBox)
Players.PlayerRemoving:Connect(removeESPBox)
for _, p in ipairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then createESPBox(p) end
end

local function getClosestPlayerToCenter()
    local target = nil
    local shortestDistance = math.huge
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, player in ipairs(Players:GetPlayers()) do
        if isEnemy(player) and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local hrp = player.Character.HumanoidRootPart
            local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
            if onScreen then
                local distance = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                if distance < shortestDistance then
                    shortestDistance = distance
                    target = player
                end
            end
        end
    end
    return target
end

RunService.RenderStepped:Connect(function()
    local tickTime = tick() * 3
    local rainbowColor = Color3.fromHSV(tickTime % 1, 1, 1)
    RGBStroke.Color = rainbowColor
    OpenStroke.Color = rainbowColor

    if settingsState.RGBColor then
        currentBoxColor = rainbowColor
    end

    -- WalkSpeed & TP Walk
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        local humanoid = LocalPlayer.Character.Humanoid
        if settingsState.WalkSpeedMultiplier > 1 then
            humanoid.WalkSpeed = 16 * settingsState.WalkSpeedMultiplier
        end
        if settingsState.TPWalk and humanoid.MoveDirection.Magnitude > 0 and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            LocalPlayer.Character.HumanoidRootPart.CFrame = LocalPlayer.Character.HumanoidRootPart.CFrame + (humanoid.MoveDirection * (settingsState.WalkSpeedMultiplier * 0.1))
        end
    end

    -- Xử lý Aimbot
    if settingsState.Aimbot then
        local aimTarget = nil
        if settingsState.AimbotTargetMode == "Closest" then
            aimTarget = getClosestPlayerToCenter()
        elseif settingsState.AimbotTargetMode == "Selected" then
            aimTarget = selectedTargetPlayer
        end

        if aimTarget and aimTarget.Character and aimTarget.Character:FindFirstChild("Head") and isEnemy(aimTarget) then
            local targetHead = aimTarget.Character.Head.Position
            if settingsState.AimbotMode == "Lock" then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHead)
            elseif settingsState.AimbotMode == "Smooth" then
                local currentCFrame = Camera.CFrame
                local targetCFrame = CFrame.new(Camera.CFrame.Position, targetHead)
                Camera.CFrame = currentCFrame:Lerp(targetCFrame, settingsState.AimbotSmoothness)
            end
        end
    end

    -- ESP Box
    for player, box in pairs(espBoxes) do
        box.Color = currentBoxColor
        if settingsState.ESPBox and isEnemy(player) and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local hrp = player.Character.HumanoidRootPart
            local vector, onScreen = Camera:WorldToViewportPoint(hrp.Position)
            if onScreen then
                local head = player.Character:FindFirstChild("Head")
                local topPosition = head and Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.8, 0)) or vector
                local bottomPosition = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 2.5, 0))
                
                local height = math.abs(topPosition.Y - bottomPosition.Y)
                local width = height / 2

                box.Size = Vector2.new(width, height)
                box.Position = Vector2.new(vector.X - width / 2, topPosition.Y)
                box.Visible = true
            else
                box.Visible = false
            end
        else
            box.Visible = false
        end
    end

    -- Hitbox X5 / X10
    if settingsState.HitboxSize > 1 then
        for _, player in ipairs(Players:GetPlayers()) do
            if isEnemy(player) and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = player.Character.HumanoidRootPart
                hrp.Size = Vector3.new(2 * settingsState.HitboxSize, 2 * settingsState.HitboxSize, 2 * settingsState.HitboxSize)
                hrp.Transparency = 0.7
                hrp.CanCollide = false
            end
        end
    end
end)

