local function updateWeaponButtons()
    for _, child in pairs(weaponContainer:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    local weaponsList = {"Tự động chọn"}
    pcall(function()
        for _, item in ipairs(LocalPlayer.Backpack:GetChildren()) do
            if item:IsA("Tool") and not table.find(weaponsList, item.Name) then
                table.insert(weaponsList, item.Name)
            end
        end
        if LocalPlayer.Character then
            for _, item in ipairs(LocalPlayer.Character:GetChildren()) do
                if item:IsA("Tool") and not table.find(weaponsList, item.Name) then
                    table.insert(weaponsList, item.Name)
                end
            end
        end
    end)

    local wPosY = 5
    for _, wName in ipairs(weaponsList) do
        local btn = Instance.new("TextButton", weaponContainer)
        btn.Position = UDim2.new(0.02, 0, 0, wPosY)
        btn.Size = UDim2.new(0.96, 0, 0, 28)
        btn.Text = wName
        btn.Font = Enum.Font.SourceSansBold
        btn.TextSize = 12
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.BackgroundColor3 = (Config.SelectedWeapon == wName) and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(55, 55, 55)
        
        btn.MouseButton1Click:Connect(function()
            Config.SelectedWeapon = wName
            updateWeaponButtons()
        end)
        wPosY = wPosY + 32
    end
    weaponContainer.CanvasSize = UDim2.new(0, 0, 0, wPosY)
end
