-- 4. HỆ THỐNG ESP (QUÁI VẬT & NGƯỜI CHƠI)
local activeDrawings = {}

local function clearEsp()
    for _, d in pairs(activeDrawings) do
        if d then d:Remove() end
    end
    activeDrawings = {}
end

local function createEsp(obj, textStr, color)
    local box = Drawing.new("Square")
    box.Visible = false
    box.Color = color
    box.Thickness = 1.5
    box.Filled = false
    table.insert(activeDrawings, box)

    local line = Drawing.new("Line")
    line.Visible = false
    line.Color = color
    line.Thickness = 1
    table.insert(activeDrawings, line)

    local info = Drawing.new("Text")
    info.Visible = false
    info.Color = color
    info.Size = 13
    info.Center = true
    info.Outline = true
    table.insert(activeDrawings, info)

    return {box = box, line = line, info = info}
end

-- 5. XỬ LÝ LOGIC CHẠY NGẦM (FIX LỖI TỐC ĐỘ, FLY, ATTACK, BRING ITEM & ESP)
RunService.RenderStepped:Connect(function()
    -- Mở khóa Zoom
    if Config.ZoomEnabled then
        LocalPlayer.CameraMaxZoomDistance = 500
        LocalPlayer.CameraMinZoomDistance = 0.5
    end

    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") then
        local hrp = char.HumanoidRootPart
        local hum = char:FindFirstChildOfClass("Humanoid")

        -- Fix lỗi tốc độ chạy bị giật lùi / reset
        if hum.WalkSpeed ~= Config.WalkSpeed then
            hum.WalkSpeed = Config.WalkSpeed
        end

        -- Fix lỗi Fly bị đứng im / kẹt
        if Config.Fly then
            hum.PlatformStand = true
            local camVec = Camera.CFrame.LookVector
            local moveDir = Vector3.new(0, 0, 0)
            if UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up) then moveDir = moveDir + camVec end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down) then moveDir = moveDir - camVec end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left) then moveDir = moveDir - Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right) then moveDir = moveDir + Camera.CFrame.RightVector end
            
            hrp.Velocity = Vector3.new(moveDir.X * 60, moveDir.Y * 60, moveDir.Z * 60)
        else
            if hum.PlatformStand then
                hum.PlatformStand = false
            end
        end

        -- Tự động tấn công theo tâm ngắm & Tốc độ đánh
        if Config.AutoAttack then
            pcall(function()
                -- Kích hoạt công cụ đang cầm hoặc đánh liên tục
                local tool = char:FindFirstChildOfClass("Tool")
                if tool then
                    if Config.AttackSpeed == "Siêu nhanh" then
                        tool:Activate()
                    else
                        task.wait(0.2)
                        tool:Activate()
                    end
                end
            end)
        end

        -- Gôm vật phẩm trong phạm vi 300 mét lại gần người chơi
        if Config.BringItem then
            pcall(function()
                for _, obj in pairs(workspace:GetDescendants()) do
                    if obj:IsA("Model") or obj:IsA("Part") then
                        -- Kiểm tra nếu là vật phẩm rơi (có thể dựa vào tên hoặc thư mục chứa đồ trong game)
                        if obj.Name:lower():find("ammo") or obj.Name:lower():find("shotgun") or obj.Name:lower():find("axe") or obj.Name:lower():find("snake_oil") or obj.Name:lower():find("knife") then
                            if obj:FindFirstChild("PrimaryPart") or obj:IsA("Part") then
                                local targetPart = obj.PrimaryPart or obj
                                if (targetPart.Position - hrp.Position).Magnitude <= 300 then
                                    targetPart.CFrame = hrp.CFrame + Vector3.new(math.random(-3,3), 0, math.random(-3,3))
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)

