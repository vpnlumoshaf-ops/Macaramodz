-- 2. LOGIC XỬ LÝ AUTO FARM & BAY TRÊN ĐẦU QUÁI
RunService.RenderStepped:Connect(function()
    if Config.AutoFarm then
        pcall(function()
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") then
                local hrp = char.HumanoidRootPart
                local hum = char:FindFirstChildOfClass("Humanoid")
                
                -- Tìm quái gần nhất trong Workspace để farm
                local targetMonster = nil
                local shortestDistance = math.huge
                
                for _, obj in pairs(Workspace.Enemies:GetChildren()) do
                    if obj:FindFirstChild("HumanoidRootPart") and obj:FindFirstChildOfClass("Humanoid") then
                        if obj.Humanoid.Health > 0 then
                            local dist = (obj.HumanoidRootPart.Position - hrp.Position).Magnitude
                            if dist < shortestDistance then
                                shortestDistance = dist
                                targetMonster = obj
                            end
                        end
                    end
                end
                
                if targetMonster then
                    local mHrp = targetMonster.HumanoidRootPart
                    -- Bay lên trên đầu quái khoảng 5 đơn vị để quái đánh hụt nhưng mình đánh tới
                    local targetCFrame = mHrp.CFrame + Vector3.new(0, 6, 0)
                    
                    -- Dịch chuyển hoặc bay mượt đến đầu quái theo tốc độ đã chọn
                    hrp.CFrame = hrp.CFrame:Lerp(targetCFrame, Config.FlySpeed / 1000)
                    
                    -- Kích hoạt đánh vũ khí / kỹ năng theo tốc độ đánh
                    local tool = char:FindFirstChildOfClass("Tool")
                    if tool then
                        if Config.AttackSpeed == "Siêu nhanh" then
                            tool:Activate()
                        elseif Config.AttackSpeed == "Tối thượng" then
                            tool:Activate()
                            task.spawn(function()
                                task.wait(0.05)
                                tool:Activate()
                            end)
                        else
                            task.wait(0.15)
                            tool:Activate()
                        end
                    end
                end
            end
        end)
    end
end)

