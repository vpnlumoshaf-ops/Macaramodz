-- 2. HỆ THỐNG TỰ ĐỘNG NHẬN NHIỆM VỤ & ĐÁNH QUÁI THÔNG MINH
local lastQuestCheck = 0
local connection
connection = RunService.RenderStepped:Connect(function()
    if not ScreenGui.Parent then
        connection:Disconnect()
        return
    end

    if Config.AutoFarm then
        pcall(function()
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") then
                local hrp = char.HumanoidRootPart
                local hum = char:FindFirstChildOfClass("Humanoid")
                
                -- Kiểm tra nhận nhiệm vụ định kỳ mỗi 3 giây để tránh spam server
                if tick() - lastQuestCheck > 3 then
                    lastQuestCheck = tick()
                    local mainGui = LocalPlayer.PlayerGui:FindFirstChild("Main")
                    local questFrame = mainGui and mainGui:FindFirstChild("Quest")
                    
                    if questFrame and not questFrame.Visible then
                        -- Lấy cấp độ hiện tại để chọn đúng loại quái/nhiệm vụ tương ứng
                        local levelVal = LocalPlayer.Data.Level.Value
                        local questData = {"StartQuest", "Bandit", 1} -- Mặc định Sea 1 đầu game
                        
                        if levelVal >= 10 and levelVal < 15 then
                            questData = {"StartQuest", "Monkey", 1}
                        elseif levelVal >= 15 and levelVal < 30 then
                            questData = {"StartQuest", "Gorilla", 1}
                        elseif levelVal >= 30 and levelVal < 60 then
                            questData = {"StartQuest", "Pirate", 1}
                        elseif levelVal >= 60 then
                            questData = {"StartQuest", "Brute", 1}
                        end
                        
                        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                        if remotes and remotes:FindFirstChild("CommF_") then
                            remotes.CommF_:InvokeServer(unpack(questData))
                        end
                    end
                end
                
                -- Tìm quái gần nhất trong Workspace
                local targetMonster = nil
                local shortestDistance = math.huge
                
                local folderEnemies = Workspace:FindFirstChild("Enemies") or Workspace:FindFirstChild("MobFolders")
                if folderEnemies then
                    local enemiesList = folderEnemies:GetChildren()
                    for i = 1, #enemiesList do
                        local obj = enemiesList[i]
                        local mHrp = obj:FindFirstChild("HumanoidRootPart")
                        local mHum = obj:FindFirstChildOfClass("Humanoid")
                        if mHrp and mHum and mHum.Health > 0 then
                            local dist = (mHrp.Position - hrp.Position).Magnitude
                            if dist < shortestDistance then
                                shortestDistance = dist
                                targetMonster = obj
                            end
                        end
                    end
                end
                
                if targetMonster then
                    local mHrp = targetMonster.HumanoidRootPart
                    -- Bay lên đầu quái cự ly an toàn 7 đơn vị
                    local targetCFrame = mHrp.CFrame + Vector3.new(0, 7, 0)
                    hrp.CFrame = hrp.CFrame:Lerp(targetCFrame, Config.FlySpeed / 1000)
                    
                    -- Kích hoạt tấn công mượt mà bằng task.spawn
                    local tool = char:FindFirstChildOfClass("Tool")
                    if tool then
                        task.spawn(function()
                            if Config.AttackSpeed == "Siêu nhanh" then
                                tool:Activate()
                            elseif Config.AttackSpeed == "Tối thượng" then
                                tool:Activate()
                                task.wait(0.02)
                                tool:Activate()
                            else
                                tool:Activate()
                                task.wait(0.12)
                            end
                        end)
                    else
                        -- Tự động cầm vũ khí trong balo lên nếu chưa cầm
                        local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
                        if backpack then
                            local firstTool = backpack:FindFirstChildOfClass("Tool")
                            if firstTool then
                                hum:EquipTool(firstTool)
                            end
                        end
                    end
                end
            end
        end)
    end
end)
