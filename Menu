-- HÀM KIỂM TRA & NHẬN NHIỆM VỤ CHUẨN XÁC 1-700 WIKI
local function checkAndGetQuestClean()
    pcall(function()
        local questGui = LocalPlayer.PlayerGui:FindFirstChild("Main") and LocalPlayer.PlayerGui.Main:FindFirstChild("Quest")
        local hasActiveQuest = questGui and questGui.Visible and questGui:FindFirstChild("Container") and questGui.Container:FindFirstChild("QuestTitle") and questGui.Container.QuestTitle.Text ~= ""
        
        if not hasActiveQuest then
            local stats = LocalPlayer:FindFirstChild("Data") and LocalPlayer.Data:FindFirstChild("Level")
            local level = stats and stats.Value or 1
            
            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local questName, npcPos = "BanditQuest1", Vector3.new(1059, 16, 1379)
                
                if level >= 1 and level <= 9 then
                    questName, npcPos = "BanditQuest1", Vector3.new(1059, 16, 1379)
                elseif level >= 10 and level <= 29 then
                    questName, npcPos = "JungleQuest", Vector3.new(-1598, 37, 153)
                elseif level >= 30 and level <= 59 then
                    questName, npcPos = "PirateQuest", Vector3.new(-1201, 4, 3855)
                elseif level >= 60 and level <= 89 then
                    questName, npcPos = "DesertQuest", Vector3.new(896, 6, 4389)
                elseif level >= 90 and level <= 119 then
                    questName, npcPos = "SnowQuest", Vector3.new(1389, 87, -1298)
                elseif level >= 120 and level <= 149 then
                    questName, npcPos = "MarineQuest", Vector3.new(-5035, 20, 4324)
                elseif level >= 150 and level <= 189 then
                    questName, npcPos = "SkyQuest", Vector3.new(-4842, 718, -2623)
                elseif level >= 190 and level <= 249 then
                    questName, npcPos = "PrisonQuest", Vector3.new(4875, 5, 735)
                elseif level >= 250 and level <= 299 then
                    questName, npcPos = "ColosseumQuest", Vector3.new(-1580, 7, -2992)
                elseif level >= 300 and level <= 374 then
                    questName, npcPos = "MagmaQuest", Vector3.new(-5315, 12, 8515)
                elseif level >= 375 and level <= 449 then
                    questName, npcPos = "FishmanQuest", Vector3.new(61123, 18, 1569)
                elseif level >= 450 and level <= 624 then
                    questName, npcPos = "SkyExp1Quest", Vector3.new(-7862, 5545, -380)
                elseif level >= 625 and level <= 700 then
                    questName, npcPos = "FountainQuest", Vector3.new(5247, 38, 4048)
                end

                if (hrp.Position - npcPos).Magnitude > 25 then
                    hrp.CFrame = CFrame.new(npcPos + Vector3.new(0, 10, 0))
                    task.wait(0.5)
                else
                    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                    if remotes and remotes:FindFirstChild("CommF_") then
                        remotes.CommF_:InvokeServer("StartQuest", questName, 1)
                        task.wait(1)
                    end
                end
            end
        end
    end)
end

