local FlyBtn = Instance.new("TextButton")
FlyBtn.Parent = TabMain
FlyBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
FlyBtn.Position = UDim2.new(0.1, 0, 0.38, 0)
FlyBtn.Size = UDim2.new(0.8, 0, 0, 32)
FlyBtn.Font = Enum.Font.SourceSansBold
FlyBtn.Text = "Fly (Joystick): Off"
FlyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
FlyBtn.TextSize = 13

local flying = false
local flySpeed = 50
local bv, bg

FlyBtn.MouseButton1Click:Connect(function()
    flying = not flying
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local root = char.HumanoidRootPart
    
    if flying then
        FlyBtn.Text = "Fly (Joystick): On"
        FlyBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        bv.Velocity = Vector3.new(0, 0, 0)
        bv.Parent = root
        bg = Instance.new("BodyGyro")
        bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        bg.CFrame = root.CFrame
        bg.Parent = root
        
        task.spawn(function()
            while flying and char and root.Parent do
                bg.CFrame = Camera.CFrame
                local moveDir = char.Humanoid.MoveDirection
                bv.Velocity = (Camera.CFrame.LookVector * moveDir.Z + Camera.CFrame.RightVector * moveDir.X) * flySpeed + Vector3.new(0, (moveDir.Y > 0 and flySpeed or 0), 0)
                RunService.RenderStepped:Wait()
            end
        end)
    else
        FlyBtn.Text = "Fly (Joystick): Off"
        FlyBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        if bv then bv:Destroy() end
        if bg then bg:Destroy() end
    end
end)

