local function createToggle(parent, text, defaultVal, callback, customY)
    local btn = Instance.new("TextButton")
    btn.Parent = parent
    btn.BackgroundColor3 = defaultVal and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(45, 45, 45)
    btn.Position = UDim2.new(0.05, 0, 0, customY)
    btn.Size = UDim2.new(0.9, 0, 0, 32)
    btn.Font = Enum.Font.SourceSansBold
    btn.Text = text .. (defaultVal and ": On" or ": Off")
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 13
    
    local state = defaultVal
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.Text = text .. (state and ": On" or ": Off")
        btn.BackgroundColor3 = state and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(45, 45, 45)
        callback(state)
    end)
    return btn
end

-- HỆ THỐNG QUÉT TỌA ĐỘ VÀ KIỂM TRA ĐẢO ĐỂ NHẬN NHIỆM VỤ CHÍNH XÁC
local function checkAndGetQuestClean()
    pcall(function()
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        local pos = char.HumanoidRootPart.Position
        
        local questName = "BanditQuest1"
        local questIndex = 1

        -- Quét khoảng cách tọa độ (X, Z) để nhận diện đang ở đảo nào
        if pos.Z > 2000 and pos.Z < 5000 and pos.X > 500 and pos.X < 1500 then
            questName = "DesertQuest"; questIndex = 1 -- Hoặc DesertQuest 2 tùy level
        elseif pos.Z > 3000 and pos.Z < 4500 and pos.X > -1500 and pos.X < -500 then
            questName = "PirateQuest"; questIndex = 1 -- Đảo Cướp Biển (Mob: Pirate / Brute)
        elseif pos.Z > -200 and pos.Z < 800 and pos.X > -1800 and pos.X < -800 then
            questName = "JungleQuest"; questIndex = 1 -- Đảo Khỉ
        elseif pos.Z > -1500 and pos.Z < -800 and pos.X > 800 and pos.X < 1800 then
            questName = "SnowQuest"; questIndex = 1 -- Đảo Tuyết
        elseif pos.Z > 500 and pos.Z < 1200 and pos.X > 4000 and pos.X < 5500 then
            questName = "PrisonQuest"; questIndex = 1 -- Nhà Tù
        elseif pos.Z > -3500 and pos.Z < -2500 and pos.X > -1800 and pos.X < -1000 then
            questName = "ColosseumQuest"; questIndex = 1 -- Đấu Trường
        elseif pos.Z > 7500 and pos.Z < 9500 and pos.X > -6000 and pos.X < -4500 then
            questName = "MagmaQuest"; questIndex = 1 -- Đảo Dung Nham
        elseif pos.Z > 1000 and pos.Z < 2500 and pos.X > 58000 and pos.X < 64000 then
            questName = "FishmanQuest"; questIndex = 1 -- Đảo Người Cá
        else
            -- Dự phòng theo Level nếu đứng ở khoảng trống
            local stats = LocalPlayer:FindFirstChild("Data") and LocalPlayer.Data:FindFirstChild("Level")
            local level = stats and stats.Value or 1
            if level >= 30 and level <= 59 then
                questName = "PirateQuest"; questIndex = 1
            elseif level >= 60 then
                questName = "DesertQuest"; questIndex = 1
            end
        end

        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        if remotes and remotes:FindFirstChild("CommF_") then
            remotes.CommF_:InvokeServer("StartQuest", questName, questIndex)
        end
    end)
end

-- KIỂM TRA XEM ĐÃ CÓ NHIỆM VỤ CHƯA
local function hasActiveQuest()
    local success, res = pcall(function()
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if playerGui then
            local mainGui = playerGui:FindFirstChild("Main")
            if mainGui then
                local questDisplay = mainGui:FindFirstChild("Quest")
                if questDisplay and questDisplay.Visible then
                    return true
                end
            end
        end
        return false
    end)
    return success and res
end

-- LẤY TÊN QUÁI TỪ BẢNG NHIỆM VỤ
local function getCurrentQuestMobName()
    local success, mobName = pcall(function()
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if playerGui then
            local mainGui = playerGui:FindFirstChild("Main")
            if mainGui then
                local questDisplay = mainGui:FindFirstChild("Quest")
                if questDisplay and questDisplay.Visible then
                    local container = questDisplay:FindFirstChild("Container")
                    if container then
                        for _, v in pairs(container:GetChildren()) do
                            if v:IsA("TextLabel") and string.find(v.Text, "Defeat") then
                                local cleaned = v.Text:gsub("Defeat ", ""):gsub("[\n%d/()%s]+", " ")
                                local parts = {}
                                for word in cleaned:gmatch("%S+") do
                                    table.insert(parts, word)
                                end
                                if #parts > 0 then
                                    return parts[1]
                                end
                            end
                        end
                    end
                end
            end
        end
        return nil
    end)
    if success and mobName then
        return mobName
    end
    return nil
end

