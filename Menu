-- 2. HỆ THỐNG ESP BOX & LINE (ĐỒ HỌA MỤC TIÊU)
local espCache = {}
local function clearESP()
    for _, obj in pairs(espCache) do
        if obj then pcall(function() obj:Remove() end) end
    end
    espCache = {}
end

-- 3. HỆ THỐNG AUTO FARM, NHẬN NHIỆM VỤ & ĐÁNH TỐC ĐỘ CAO
local lastQuestTick = 0
local camera = Workspace.CurrentCamera

local function getCurrentQuestTarget()
    local success, questData = pcall(function()
        return LocalPlayer.PlayerGui.Main.Quest.Visible, LocalPlayer.PlayerGui.Main.Quest.Container.QuestTitle.Text
    end)
    if success and questData then
        -- Trích xuất tên quái từ bảng nhiệm vụ của game
        return LocalPlayer.PlayerGui.Main.Quest.Visible
    end
    return false
end

RunService.RenderStepped:Connect(function()
    if not ScreenGui.Parent then 
        clearESP()
        return 
    end

    -- Xử lý ESP quái nhiệm vụ
    if Config.ShowESP then
        -- Thu thập danh sách tên quái mục tiêu hiện tại
        local targetMobNames = {}
        pcall(function()
            local qTitle = LocalPlayer.PlayerGui.Main.Quest.Container.QuestTitle.Text
            if qTitle:find("Bandit") then table.insert(targetMobNames, "Bandit")
            elseif qTitle:find("Monkey") then table.insert(targetMobNames, "Monkey")
            elseif qTitle:find("Gorilla") then table.insert(targetMobNames, "Gorilla")
            elseif qTitle:find("Pirate") then table.insert(targetMobNames, "Pirate")
            elseif qTitle:find("Brute") then table.insert(targetMobNames, "Brute")
            elseif qTitle:find("Desert Bandit") or qTitle:find("DesertBandit") then table.insert(targetMobNames, "Desert Bandit")
            elseif qTitle:find("Snow Trooper") then table.insert(targetMobNames, "Snow Trooper")
            else table.insert(targetMobNames, "") -- Nếu chưa rõ hiện tất cả quanh đó
            end
        end)

        local folderEnemies = Workspace:FindFirstChild("Enemies") or Workspace:FindFirstChild("MobFolders")
        if folderEnemies then
            local enemies = folderEnemies:GetChildren()
            local activeFound = {}
            for _, mob in ipairs(enemies) do
                local hrp = mob:FindFirstChild("HumanoidRootPart")
                local hum = mob:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 then
                    -- Tạo hoặc cập nhật Drawing Box & Line
                    if not espCache[mob] then
                        local box = Drawing.new("Square")
                        box.Visible = false
                        box.Color = Color3.fromRGB(255, 0, 0)
                        box.Thickness = 1.5
                        box.Filled = false

                        local line = Drawing.new("Line")
                        line.Visible = false
                        line.Color = Color3.fromRGB(255, 170, 0)
                        line.Thickness = 1

                        espCache[mob] = {Box = box, Line = line}
                    end

                    local vector, onScreen = camera:WorldToViewportPoint(hrp.Position)
                    if onScreen then
                        local scale = math.clamp(1000 / (camera.CFrame.Position - hrp.Position).Magnitude, 0.5, 3)
                        local boxW, boxH = 35 * scale, 55 * scale
                        
                        local boxObj = espCache[mob].Box
                        boxObj.Size = Vector2.new(boxW, boxH)
                        boxObj.Position = Vector2.new(vector.X - boxW/2, vector.Y - boxH/2)
                        boxObj.Visible = true

                        local lineObj = espCache[mob].Line
                        lineObj.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
                        lineObj.To = Vector2.new(vector.X, vector.Y)
                        lineObj.Visible = true
                        activeFound[mob] = true
                    else
                        espCache[mob].Box.Visible = false
                        espCache[mob].Line.Visible = false
                    end
                end
            end
            -- Dọn dẹp ESP quái đã chết
            for m, elements in pairs(espCache) do
                if not activeFound[m] then
                    pcall(function()
                        elements.Box.Visible = false
                        elements.Line.Visible = false
                    end)
                end
            end
        end
    else
        clearESP()
    end

    -- Xử lý Logic Auto Farm
    if Config.AutoFarm then
        pcall(function()
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") then
                local hrp = char.HumanoidRootPart
                local hum = char:FindFirstChildOfClass("Humanoid")

                -- 1. Tự động nhận nhiệm vụ chuẩn xác mỗi 2 giây nếu chưa có bảng Q hiển thị
                local mainGui = LocalPlayer.PlayerGui:FindFirstChild("Main")
                local questGui = mainGui and mainGui:FindFirstChild("Quest")
                if questGui and not questGui.Visible then
                    if tick() - lastQuestTick > 2 then
                        lastQuestTick = tick()
                        local level = LocalPlayer.Data.Level.Value
                        local questArgs = {"StartQuest", "Bandit", 1}

                        if level >= 10 and level < 15 then
                            questArgs = {"StartQuest", "Monkey", 1}
                        elseif level >= 15 and level < 30 then
                            questArgs = {"StartQuest", "Gorilla", 1}
                        elseif level >= 30 and level < 60 then
                            questArgs = {"StartQuest", "Pirate", 1}
                        elseif level >= 60 and level < 90 then
                            questArgs = {"StartQuest", "Brute", 1}
                        elseif level >= 90 and level < 120 then
                            questArgs = {"StartQuest", "DesertBandit", 1}
                        elseif level >= 120 and level < 150 then
                            questArgs = {"StartQuest", "SnowBandit", 1}
                        end

                        local commF = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
                        if commF then
                            commF:InvokeServer(unpack(questArgs))
                        end
                    end
                end

                -- 2. Tìm quái gần nhất để bay đến và đánh
                local targetMob = nil
                local shortestDist = math.huge
                local folderEnemies = Workspace:FindFirstChild("Enemies") or Workspace:FindFirstChild("MobFolders")
                if folderEnemies then
                    for _, mob in ipairs(folderEnemies:GetChildren()) do
                        local mobHrp = mob:FindFirstChild("HumanoidRootPart")
                        local mobHum = mob:FindFirstChildOfClass("Humanoid")
                        if mobHrp and mobHum and mobHum.Health > 0 then
                            local d = (mobHrp.Position - hrp.Position).Magnitude
                            if d < shortestDist then
                                shortestDist = d
                                targetMob = mob
                            end
                        end
                    end
                end

                if targetMob then
                    local mHrp = targetMob.HumanoidRootPart
                    -- Bay mượt bám sát phía trên đầu quái
                    hrp.CFrame = hrp.CFrame:Lerp(mHrp.CFrame + Vector3.new(0, 7, 0), Config.FlySpeed / 800)

                    -- 3. Cơ chế đánh cực nhanh tối ưu hóa đa tầng qua VirtualUser & Tool:Activate()
                    local tool = char:FindFirstChildOfClass("Tool")
                    if tool then
                        if Config.AttackSpeed == "Tối thượng (0s delay)" then
                            pcall(function()
                                tool:Activate()
                                VirtualUser:Button1Down(Vector2.new(0,0), camera.CFrame)
                                VirtualUser:Button1Up(Vector2.new(0,0), camera.CFrame)
                            end)
                        elseif Config.AttackSpeed == "Siêu nhanh" then
                            pcall(function()
                                tool:Activate()
                                VirtualUser:Button1Down(Vector2.new(0,0), camera.CFrame)
                            end)
                            task.spawn(function()
                                task.wait(0.02)
                                pcall(function() VirtualUser:Button1Up(Vector2.new(0,0), camera.CFrame) end)
                            end)
                        else
                            tool:Activate()
                            task.wait(0.05)
                        end
                    else
                        -- Tự động cầm vũ khí từ balo lên nếu chưa cầm
                        local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
                        if backpack then
                            local firstTool = backpack:FindFirstChildOfClass("Tool")
                            if firstTool then
                                hum:EquipTool(firstTool)
                            end
                        end
                    end
                end
            end
        end)
    end
end)

